<!doctype html>
<html lang="en" data-theme="{{ site.theme or 'light' }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title or site.title }}</title>
<meta name="description" content="{{ description or site.description }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta name="theme-color" content="#0E2340">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{#- Same type as R&R Grandeur Properties; Playfair and Barlow Condensed are subset to the logo letters. #}
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500&family=Barlow+Condensed:wght@500&text=JRCAPITLapitl&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/industry.css">
<link rel="stylesheet" href="/assets/css/site.css">
<link rel="stylesheet" href="/assets/css/glass.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="site-head" data-head>
  <div class="head-in" data-gutter>
    <a class="brand" href="/#top" aria-label="{{ site.name }}, home">
      <span class="logo logo-on-field" aria-hidden="true"><span class="logo-jr">JR</span><span class="logo-word">Capital</span></span>
    </a>
    <nav class="navlinks" aria-label="Sections">
      {%- for item in site.nav %}
      <a class="navlink" href="/#{{ item.target }}" data-nav="{{ item.target }}">{{ item.label }}</a>
      {%- endfor %}
    </nav>
    <a class="head-cta" href="/#invest">Contact<span class="hide-s"> us</span></a>
  </div>
  <span class="scroll-progress" data-progress aria-hidden="true"></span>
</header>

<div id="main">
{{ content | safe }}
</div>

<footer class="site-foot">
  <div class="foot-in" data-gutter>
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="brand" href="/#top" aria-label="{{ site.name }}, home">
          <span class="logo logo-on-field" aria-hidden="true"><span class="logo-jr">JR</span><span class="logo-word">Capital</span></span>
        </a>
        <p class="foot-addr">{{ site.address }}</p>
      </div>
      {%- if site.companies and site.companies.length %}
      <nav aria-labelledby="footer-companies">
        <div class="foot-k" id="footer-companies">{{ site.companies_heading or 'Our companies' }}</div>
        <ul class="foot-list">
          {%- for co in site.companies %}
          <li><a class="foot-link" href="{{ co.url }}" target="_blank" rel="noopener">{{ co.name }}<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens in a new tab)</span></a></li>
          {%- endfor %}
        </ul>
      </nav>
      {%- endif %}
      <nav aria-labelledby="footer-explore">
        <div class="foot-k" id="footer-explore">Explore</div>
        <ul class="foot-list">
          {%- for item in site.nav %}
          <li><a class="foot-link" href="/#{{ item.target }}">{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
      <div>
        <div class="foot-k">Contact</div>
        <ul class="foot-list">
          {%- if site.email %}<li><a class="foot-link" href="mailto:{{ site.email }}">{{ site.email }}</a></li>{% endif %}
          <li><a class="foot-link" href="{{ site.portal_url }}">Investor portal</a></li>
        </ul>
      </div>
    </div>
    <div id="disclosures" class="foot-disc">
      {%- for para in site.disclosures %}
      <p>{{ para }}</p>
      {%- endfor %}
    </div>
    <div class="foot-base">
      <span>© {{ year }} {{ site.name }}. All rights reserved.</span>
      <span class="foot-legal">
        <a class="foot-link" href="/legal/privacy.html">Privacy policy</a>
        <a class="foot-link" href="/legal/terms.html">Terms of use</a>
      </span>
    </div>
  </div>
</footer>
<script src="/assets/js/main.js" defer></script>
</body>
</html>
