---
layout: base.njk
noindex: true
---
  <main data-gutter class="legal">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span class="crumbs-sep" aria-hidden="true">→</span><span aria-current="page">{{ heading }}</span></nav>
    <h1>{{ heading }}</h1>
    {%- if updated %}<div class="legal-date">Last updated: {{ updated }}</div>{% endif %}
    {%- if note %}<p class="legal-note"><strong>{{ note_label }}</strong> {{ note }}</p>{% endif %}
    <div class="legal-body">{{ content | safe }}</div>
  </main>
